# Backend environment template. Copy to `backend/.env` (gitignored) and fill in.
# NEVER put real secrets in this file — it is committed. Real values live only
# in the untracked .env, and in production come from the host's secret store.

# ─── Core ────────────────────────────────────────────────────────────────────
# Django SECRET_KEY. Required — base.py reads it with no default, so the app
# will not start without it, and production must NOT reuse a development value.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-key

# True only in local development. Production settings force it False.
DEBUG=True

# ─── Databases (per-country sharding) ────────────────────────────────────────
# Local dev defaults to SQLite files; production uses managed Postgres URLs.
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL_KENYA=sqlite:///db_ke.sqlite3
DATABASE_URL_RWANDA=sqlite:///db_rw.sqlite3
DATABASE_URL_GHANA=sqlite:///db_gh.sqlite3

# ─── Cache / broker ──────────────────────────────────────────────────────────
# Optional locally: if Redis is unreachable, development falls back to an
# in-memory cache automatically.
REDIS_URL=redis://localhost:6379/0

# ─── JWT signing keys (RS256) ────────────────────────────────────────────────
# Paths to the PEM keypair, relative to the backend directory. Generate a dev
# pair into backend/secrets/ (gitignored). PRODUCTION WILL NOT BOOT without
# these: the HS256/SECRET_KEY fallback is disabled outside development.
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem

# ─── Email (Resend via SMTP) ─────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in development to print emails to the console
# instead of sending. Set it to rehearse real delivery.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=OrbiSave <noreply@orbisave.com>

# ─── Rate limiting / proxy (optional overrides) ──────────────────────────────
# Comma-separated proxy IPs whose X-Forwarded-For may be trusted. Empty locally.
# TRUSTED_PROXY_IPS=
# ADMIN_GATE_PER_MINUTE=300
