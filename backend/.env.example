# Backend environment template. Copy to `backend/.env` (gitignored) and fill in.
# NEVER put real secrets in this file — it is committed. Real values live only
# in the untracked .env, and in production come from the host's secret store.

# ─── Core ────────────────────────────────────────────────────────────────────
# Django SECRET_KEY. Required — base.py reads it with no default, so the app
# will not start without it, and production must NOT reuse a development value.
# Generate a URL-safe key (NOT get_random_secret_key, which can emit '$'): a '$'
# in an env-file value is interpolated/blanked by docker compose's env_file
# loader, so the container would get a corrupted key. A URL-safe key is '$'-free
# and safe across compose, shells, and systemd.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-generated-key

# True only in local development. Production settings force it False.
DEBUG=True

# ─── Databases (per-country sharding) ────────────────────────────────────────
# Run dev against the SAME engine as production (Postgres), so behaviour matches
# (advisory locks, constraints, migrations).
#
# RECOMMENDED: a native/local PostgreSQL service on port 5432 (always-on Windows
# service, survives reboots, no Docker Desktop dependency). One-time setup as the
# postgres superuser:
#   CREATE ROLE orbisave LOGIN CREATEDB PASSWORD 'dev_password';
#   CREATE DATABASE orbisave     OWNER orbisave;
#   CREATE DATABASE orbisave_ke  OWNER orbisave;
#   CREATE DATABASE orbisave_rw  OWNER orbisave;
#   CREATE DATABASE orbisave_gh  OWNER orbisave;
# then: python manage.py migrate_all && python manage.py seed_dev_accounts
DATABASE_URL=postgresql://orbisave:dev_password@localhost:5432/orbisave
DATABASE_URL_KENYA=postgresql://orbisave:dev_password@localhost:5432/orbisave_ke
DATABASE_URL_RWANDA=postgresql://orbisave:dev_password@localhost:5432/orbisave_rw
DATABASE_URL_GHANA=postgresql://orbisave:dev_password@localhost:5432/orbisave_gh
#
# ALTERNATIVE (Docker): `docker compose -f infrastructure/docker/docker-compose.yml
# up -d db` exposes Postgres on host port 5433 (use :5433 above). Note Docker
# Desktop on Windows can be unreliable; the native service above is preferred.

# Alternative (no Docker): SQLite files. Zero setup, but does NOT exercise the
# financial-engine concurrency (pg_advisory_xact_lock is a no-op on SQLite), so
# prefer Postgres before shipping anything money-related.
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL_KENYA=sqlite:///db_ke.sqlite3
# DATABASE_URL_RWANDA=sqlite:///db_rw.sqlite3
# DATABASE_URL_GHANA=sqlite:///db_gh.sqlite3

# ─── Cache / broker ──────────────────────────────────────────────────────────
# Optional locally: if Redis is unreachable, development falls back to an
# in-memory cache automatically.
REDIS_URL=redis://localhost:6379/0

# ─── JWT signing keys (RS256) ────────────────────────────────────────────────
# Paths to the PEM keypair, relative to the backend directory. Generate a dev
# pair into backend/secrets/ (gitignored). PRODUCTION WILL NOT BOOT without
# these: the HS256/SECRET_KEY fallback is disabled outside development.
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem

# ─── Email (Resend via SMTP) ─────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in development to print emails to the console
# instead of sending. Set it to rehearse real delivery.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=OrbiSave <noreply@orbisave.com>

# ─── Rate limiting / proxy (optional overrides) ──────────────────────────────
# Comma-separated proxy IPs whose X-Forwarded-For may be trusted. Empty locally.
# TRUSTED_PROXY_IPS=
# ADMIN_GATE_PER_MINUTE=300
